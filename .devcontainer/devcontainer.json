{
  "name": "Java 21 + 17",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "additionalVersions": "17",
      "jdkDistro": "tem",
      "installMaven": "true",
      "installGradle": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot"
      ],
      "settings": {
        "java.configuration.runtimes": [
          { "name": "JavaSE-17", "path": "/usr/local/sdkman/candidates/java/17" },
          { "name": "JavaSE-21", "path": "/usr/local/sdkman/candidates/java/21", "default": true }
        ]
      }
    }
  },
  "postCreateCommand": "java -version && mvn -version"
}
